NVCC		= nvcc
FLAGS		= -arch=sm_80 -Xcompiler -fpermissive
DFLAGS	= -lineinfo
RFLAGS 	= -O3 -DNDEBUG 

LINKFLAGS = 

all: release 

debug: LINKFLAGS += 

release: 	FLAGS += $(RFLAGS)
debug: 		FLAGS += $(DFLAGS)

release: lulesh
debug: lulesh

lulesh: allocator.o lulesh_main.o lulesh_compute.o 
	$(NVCC) $(LINKFLAGS) allocator.o lulesh_main.o lulesh_compute.o -o lulesh

allocator.o: ../src/allocator.cu ../src/vector.h
	$(NVCC) $(FLAGS) ../src/allocator.cu -I../src/ -c -o allocator.o

lulesh_compute.o: ../src/lulesh_compute.cu ../src/lulesh_split.h ../src/util.h ../src/vector.h ../src/allocator.h
	$(NVCC) $(FLAGS) ../src/lulesh_compute.cu -I../src/ -DUSE_CUDA -DNO_MPI -c -o lulesh_compute.o

lulesh_main.o: ../src/lulesh_main.cu ../src/lulesh_split.h ../src/util.h ../src/vector.h ../src/allocator.h
	$(NVCC) $(FLAGS) ../src/lulesh_main.cu -I../src/ -DUSE_CUDA -DNO_MPI -c -o lulesh_main.o


clean: 
	rm -rf allocator.o lulesh_main.o lulesh_compute.o  lulesh xyz.asc regNumList.txt