NVCC		= nvcc
FLAGS		= -arch=sm_80
DFLAGS	= -lineinfo
RFLAGS 	= -O3 -DNDEBUG 

LINKFLAGS = 

all: release 

debug: LINKFLAGS += 

release: 	FLAGS += $(RFLAGS)
debug: 		FLAGS += $(DFLAGS)

release: lulesh
debug: lulesh

lulesh: allocator.o lulesh_main.o lulesh_compute.o lulesh_comms.o lulesh_comms_gpu.o
	$(NVCC) $(LINKFLAGS) allocator.o lulesh_main.o lulesh_compute.o lulesh_comms.o lulesh_comms_gpu.o -o lulesh

allocator.o: ../src/original/allocator.cu ../src/original/vector.h
	$(NVCC) $(FLAGS) ../src/original/allocator.cu -I../src/original/ -c -o allocator.o

lulesh_main.o: ../src/original/lulesh_main.cu ../src/original/util.h ../src/original/vector.h ../src/original/allocator.h
	$(NVCC) $(FLAGS) ../src/original/lulesh_main.cu -I../src/original/ -DUSE_CUDA -DNO_MPI -c -o lulesh_main.o

lulesh_compute.o: ../src/original/lulesh_compute.cu  ../src/original/lulesh_kernels.h ../src/original/sm_utils.inl
	$(NVCC) $(FLAGS) ../src/original/lulesh_compute.cu -I../src/original/ -DUSE_CUDA -DNO_MPI -c -o lulesh_compute.o

lulesh_comms.o: ../src/original/lulesh-comms.cu 
	$(NVCC) $(FLAGS) ../src/original/lulesh-comms.cu -I../src/original/ -DUSE_CUDA -DNO_MPI -c -o lulesh_comms.o

lulesh_comms_gpu.o: ../src/original/lulesh-comms-gpu.cu 
	$(NVCC) $(FLAGS) ../src/original/lulesh-comms-gpu.cu -I../src/original/ -DUSE_CUDA -DNO_MPI -c -o lulesh_comms_gpu.o

clean: 
	rm -rf allocator.o lulesh_main.o lulesh_compute.o lulesh_comms.o lulesh_comms_gpu.o lulesh xyz.asc regNumList.txt